<?xml version="1.0"?>

<robot name="palm_trimmer" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="orange">
    <color rgba="0.9 0.4 0.1 1.0"/>
  </material>

  <!-- Main robot frame -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="0.35" length="0.10"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry>
        <cylinder radius="0.35" length="0.10"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>

  <!-- One placeholder arm -->
  <link name="arm_link">
    <visual>
      <origin xyz="0.30 0 0"/>
      <geometry>
        <box size="0.60 0.12 0.12"/>
      </geometry>
      <material name="orange"/>
    </visual>

    <collision>
      <origin xyz="0.30 0 0"/>
      <geometry>
        <box size="0.60 0.12 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0.30 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
               iyy="0.01" iyz="0.0"
               izz="0.01"/>
    </inertial>
  </link>

  <!-- Sliding arm joint -->
  <joint name="arm_extension_joint" type="prismatic">
    <parent link="base_link"/>
    <child link="arm_link"/>
    <origin xyz="0 0 0.10"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.50" effort="100" velocity="0.20"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="arm_extension_joint">
      <command_interface name="position">
        <param name="min">0.0</param>
        <param name="max">0.50</param>
      </command_interface>

      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>

      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin
      filename="gz_ros2_control-system"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(find palm_trimmer_description)/config/controllers.yaml
      </parameters>

    </plugin>
  </gazebo>  
</robot>
